<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مدیریت کنسول هوشمند - گیم‌نت نوا</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet" type="text/css" />
    <style>
        body { font-family: 'Vazirmatn', sans-serif; color: #f8fafc; }
        .neon-glow { box-shadow: 0 0 25px rgba(6, 182, 212, 0.2); }
        .glass { background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(16px); }

        /* موشن‌گرافیک پس‌زمینه پیشرفته و نئونی */
        .motion-bg {
            background: linear-gradient(135deg, #020617 0%, #090d16 50%, #0f172a 100%);
            position: relative;
            overflow: hidden;
        }
        .motion-bg::before, .motion-bg::after {
            content: '';
            position: absolute;
            width: 500px;
            height: 500px;
            border-radius: 50%;
            filter: blur(120px);
            z-index: 0;
            animation: floatGlow 10s ease infinite alternate;
        }
        .motion-bg::before {
            background: rgba(6, 182, 212, 0.15);
            top: -100px;
            right: -100px;
        }
        .motion-bg::after {
            background: rgba(59, 130, 246, 0.15);
            bottom: -100px;
            left: -100px;
            animation-delay: -5s;
        }
        @keyframes floatGlow {
            0% { transform: translateY(0) scale(1); }
            100% { transform: translateY(50px) scale(1.1); }
        }
    </style>
</head>
<body class="min-h-screen relative flex items-center justify-center overflow-hidden motion-bg">

    <!-- فرم ورود / فعال‌سازی (رمز پیش‌فرض: 1234) -->
    <div id="loginModal" class="absolute inset-0 z-50 flex items-center justify-center bg-slate-950/90 backdrop-blur-md p-4">
        <div class="glass border border-slate-800 p-8 rounded-3xl w-full max-w-md shadow-2xl neon-glow text-center z-10">
            <div class="bg-cyan-500/10 w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-4 border border-cyan-500/30 text-2xl text-cyan-400">🎮</div>
            <h2 class="text-2xl font-bold text-white mb-2">ورود به سیستم مدیریت نوا</h2>
            <p class="text-xs text-cyan-400 mb-6 font-bold">گیم‌نت نوا (شوشتر) — نسخه ۱۲</p>
            
            <form onsubmit="handleLogin(event)" class="space-y-4 text-right">
                <div>
                    <label class="block text-xs text-slate-300 mb-1">رمز عبور سیستم</label>
                    <input type="password" id="loginPassword" placeholder="••••" required class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-white text-center tracking-widest focus:outline-none focus:border-cyan-500">
                </div>
                <button type="submit" class="w-full bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 text-white font-medium py-3 rounded-xl transition shadow-lg shadow-cyan-500/20 cursor-pointer">ورود به پنل مدیریت</button>
            </form>
            <p id="loginError" class="text-xs text-rose-400 mt-3 hidden">رمز عبور اشتباه است!</p>
        </div>
    </div>

    <!-- برنامه اصلی -->
    <div id="appContainer" class="hidden w-full h-screen flex z-10">

        <!-- پنل کناری کشویی (باز شدن با هاور ماوس) -->
        <aside class="w-20 hover:w-72 transition-all duration-300 ease-in-out glass border-l border-slate-800/80 p-4 flex flex-col justify-between overflow-hidden group z-20 shadow-2xl">
            <div>
                <div class="flex items-center gap-4 mb-8 whitespace-nowrap">
                    <div class="bg-cyan-500/10 p-3 rounded-2xl border border-cyan-500/30 text-cyan-400 text-xl shrink-0">⚡</div>
                    <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                        <h1 class="font-bold text-base text-white">گیم‌نت نوا</h1>
                        <p class="text-xs text-cyan-400">شوشتر — نسخه ۱۲</p>
                    </div>
                </div>

                <!-- منو -->
                <nav class="space-y-2">
                    <a href="#" onclick="switchTab('dashboard')" id="nav-dashboard" class="flex items-center gap-4 px-3 py-3 rounded-xl bg-cyan-600 text-white font-medium transition whitespace-nowrap">
                        <span class="text-xl shrink-0">🎮</span> <span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300">مدیریت کنسول‌ها</span>
                    </a>
                    <a href="#" onclick="switchTab('settings')" id="nav-settings" class="flex items-center gap-4 px-3 py-3 rounded-xl text-slate-400 hover:bg-slate-800 hover:text-white transition whitespace-nowrap">
                        <span class="text-xl shrink-0">⚙️</span> <span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300">تنظیمات قیمت</span>
                    </a>
                    <a href="#" onclick="switchTab('about')" id="nav-about" class="flex items-center gap-4 px-3 py-3 rounded-xl text-slate-400 hover:bg-slate-800 hover:text-white transition whitespace-nowrap">
                        <span class="text-xl shrink-0">ℹ️</span> <span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300">درباره ما</span>
                    </a>
                </nav>
            </div>

            <!-- بخش دانلود نسخه ویندوز و سازنده -->
            <div class="space-y-3 whitespace-nowrap">
                <button onclick="downloadApp()" class="w-full flex items-center gap-3 bg-emerald-600/20 hover:bg-emerald-600/30 border border-emerald-500/30 text-emerald-400 p-3 rounded-xl transition cursor-pointer text-xs font-medium">
                    <span class="text-lg shrink-0">📥</span> 
                    <span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300">دانلود نسخه ویندوز</span>
                </button>
                <div class="bg-slate-900/50 p-3 rounded-2xl border border-slate-800 text-xs text-slate-400 text-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    گروه برنامه‌نویسی منجزی
                </div>
            </div>
        </aside>

        <!-- محتوای اصلی -->
        <main class="flex-1 p-6 md:p-10 overflow-y-auto z-10">
            
            <!-- تب داشبورد -->
            <div id="tab-dashboard">
                <header class="flex justify-between items-center mb-8 glass p-5 rounded-2xl border border-slate-800">
                    <div>
                        <h2 class="text-xl font-bold text-white">وضعیت کنسول‌ها</h2>
                        <p class="text-xs text-slate-400 mt-1">مدیریت آنلاین و زنده دستگاه‌ها</p>
                    </div>
                    <div class="bg-slate-900 px-5 py-2.5 rounded-xl border border-slate-800">
                        <span class="text-xs text-slate-400">نرخ هر ساعت:</span>
                        <span id="displayRate" class="font-bold text-emerald-400 mr-1">۰</span> <span class="text-xs text-slate-400">تومان</span>
                    </div>
                </header>

                <div id="consolesContainer" class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6"></div>
            </div>

            <!-- تب تنظیمات -->
            <div id="tab-settings" class="hidden max-w-xl">
                <header class="mb-8">
                    <h2 class="text-xl font-bold text-white">تنظیمات سیستم</h2>
                    <p class="text-xs text-slate-400 mt-1">تغییر نرخ و مدیریت سخت‌افزارها</p>
                </header>

                <div class="glass border border-slate-800 rounded-2xl p-6 space-y-6 neon-glow">
                    <div>
                        <label class="block text-sm text-slate-300 mb-2">نرخ هر ساعت بازی (تومان)</label>
                        <div class="flex gap-3">
                            <input type="number" id="inputRate" class="flex-1 bg-slate-900 border border-slate-800 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-cyan-500">
                            <button onclick="updateRate()" class="bg-cyan-600 hover:bg-cyan-500 text-white px-5 rounded-xl transition cursor-pointer">ذخیره نرخ</button>
                        </div>
                    </div>

                    <hr class="border-slate-800">

                    <div>
                        <label class="block text-sm text-slate-300 mb-2">نام کنسول جدید</label>
                        <div class="flex gap-3">
                            <input type="text" id="inputConsoleName" placeholder="مثلاً: PS5 - اتاق VIP" class="flex-1 bg-slate-900 border border-slate-800 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-cyan-500">
                            <button onclick="addConsole()" class="bg-emerald-600 hover:bg-emerald-500 text-white px-5 rounded-xl transition cursor-pointer">افزودن</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- تب درباره ما -->
            <div id="tab-about" class="hidden max-w-xl">
                <header class="mb-8">
                    <h2 class="text-xl font-bold text-white">درباره نرم‌افزار</h2>
                    <p class="text-xs text-slate-400 mt-1">اطلاعات توسعه‌دهنده و پشتیبانی</p>
                </header>

                <div class="glass border border-slate-800 rounded-2xl p-8 space-y-4 neon-glow text-center">
                    <div class="bg-cyan-500/10 w-20 h-20 rounded-3xl flex items-center justify-center mx-auto mb-4 border border-cyan-500/30 text-3xl text-cyan-400">🎮</div>
                    <h3 class="text-xl font-bold text-white">سامانه مدیریت کنسول هوشمند</h3>
                    <p class="text-cyan-400 font-bold">گیم‌نت نوا (شوشتر) — نسخه ۱۲</p>
                    <p class="text-sm text-slate-300 pt-2">طراحی و توسعه توسط: <span class="text-white font-bold">گروه برنامه‌نویسی منجزی</span></p>
                    <div class="bg-slate-900/80 p-4 rounded-xl border border-slate-800 text-xs text-slate-400 space-y-1">
                        <p>📞 تلفن تماس: 09044184477</p>
                        <p>✉️ ایمیل: am.at.aw.s.t.r@gmail.com</p>
                    </div>
                </div>
            </div>

        </main>
    </div>

    <!-- اسکریپت منطق برنامه -->
    <script>
        let hourlyRate = localStorage.getItem('nova_rate') ? parseInt(localStorage.getItem('nova_rate')) : 60000;
        let consoles = JSON.parse(localStorage.getItem('nova_consoles')) || [
            { id: 1, name: 'پلی‌استیشن ۵ (شماره ۱)', active: false, startTime: null, elapsed: 0 },
            { id: 2, name: 'پلی‌استیشن ۵ (شماره ۲)', active: false, startTime: null, elapsed: 0 },
            { id: 3, name: 'ایکس‌باکس سری ایکس', active: false, startTime: null, elapsed: 0 }
        ];
        let timers = {};

        function handleLogin(e) {
            e.preventDefault();
            const pass = document.getElementById('loginPassword').value;
            if (pass === '1234') {
                document.getElementById('loginModal').classList.add('hidden');
                document.getElementById('appContainer').classList.remove('hidden');
                renderUI();
            } else {
                document.getElementById('loginError').classList.remove('hidden');
            }
        }

        function downloadApp() {
            alert('بسته نصبی ویندوز (نسخه ۱۲ - گیم‌نت نوا) آماده دانلود است. فایل اجرایی نرم‌افزار به زودی دانلود خواهد شد.');
        }

        function saveToStorage() {
            localStorage.setItem('nova_rate', hourlyRate);
            localStorage.setItem('nova_consoles', JSON.stringify(consoles));
        }

        function renderUI() {
            document.getElementById('displayRate').innerText = hourlyRate.toLocaleString('fa-IR');
            document.getElementById('inputRate').value = hourlyRate;

            const container = document.getElementById('consolesContainer');
            container.innerHTML = '';

            consoles.forEach(c => {
                let cost = Math.round((c.elapsed / 3600) * hourlyRate);
                let hours = Math.floor(c.elapsed / 3600);
                let minutes = Math.floor((c.elapsed % 3600) / 60);
                let seconds = c.elapsed % 60;
                let timeStr = String(hours).padStart(2, '0') + ":" + String(minutes).padStart(2, '0') + ":" + String(seconds).padStart(2, '0');

                let card = document.createElement('div');
                card.className = "glass border border-slate-800 rounded-2xl p-5 shadow-xl flex flex-col justify-between neon-glow";
                card.innerHTML = `
                    <div>
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="font-bold text-white text-base">${c.name}</h3>
                            <span class="px-3 py-1 text-xs rounded-full ${c.active ? 'bg-rose-500/20 text-rose-400 border border-rose-500/30' : 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30'}">
                                ${c.active ? 'مشغول' : 'آزاد'}
                            </span>
                        </div>
                        <div class="space-y-2 mb-6 text-sm text-slate-300">
                            <div class="flex justify-between"><span>مدت زمان:</span> <span class="font-mono font-bold text-cyan-400">${timeStr}</span></div>
                            <div class="flex justify-between border-t border-slate-800 pt-2 font-bold"><span>مبلغ قابل پرداخت:</span> <span class="text-emerald-400">${cost.toLocaleString('fa-IR')} تومان</span></div>
                        </div>
                    </div>
                    <div class="grid grid-cols-3 gap-2">
                        <button onclick="toggleConsole(${c.id})" class="${c.active ? 'bg-rose-600 hover:bg-rose-500' : 'bg-cyan-600 hover:bg-cyan-500'} text-white font-medium py-2.5 px-2 rounded-xl transition cursor-pointer text-xs">
                            ${c.active ? 'پایان' : 'شروع'}
                        </button>
                        <button onclick="resetConsole(${c.id})" class="bg-amber-600/80 hover:bg-amber-600 text-white font-medium py-2.5 px-2 rounded-xl transition cursor-pointer text-xs">ریست</button>
                        <button onclick="deleteConsole(${c.id})" class="bg-slate-800 hover:bg-rose-900/40 text-slate-400 hover:text-rose-400 font-medium py-2.5 px-2 rounded-xl transition cursor-pointer text-xs">حذف</button>
                    </div>
                `;
                container.appendChild(card);

                if (c.active && !timers[c.id]) {
                    startInterval(c.id);
                }
            });
        }

        function toggleConsole(id) {
            let c = consoles.find(item => item.id === id);
            if (!c.active) {
                c.active = true;
                c.startTime = Date.now() - (c.elapsed * 1000);
                startInterval(id);
            } else {
                c.active = false;
                clearInterval(timers[id]);
                delete timers[id];
                alert(`فاکتور کنسول ${c.name} بسته شد.`);
            }
            saveToStorage();
            renderUI();
        }

        function resetConsole(id) {
            if (confirm('آیا می‌خواهید زمان و هزینه این کنسول را بازنشانی (صفر) کنید؟')) {
                if (timers[id]) {
                    clearInterval(timers[id]);
                    delete timers[id];
                }
                let c = consoles.find(item => item.id === id);
                c.active = false;
                c.startTime = null;
                c.elapsed = 0;
                saveToStorage();
                renderUI();
            }
        }

        function startInterval(id) {
            timers[id] = setInterval(() => {
                let c = consoles.find(item => item.id === id);
                if (c && c.active) {
                    c.elapsed = Math.floor((Date.now() - c.startTime) / 1000);
                    renderUI();
                }
            }, 1000);
        }

        function addConsole() {
            let name = document.getElementById('inputConsoleName').value.trim();
            if (!name) return alert('لطفاً نام کنسول را وارد کنید.');
            let newId = consoles.length > 0 ? Math.max(...consoles.map(i => i.id)) + 1 : 1;
            consoles.push({ id: newId, name: name, active: false, startTime: null, elapsed: 0 });
            document.getElementById('inputConsoleName').value = '';
            saveToStorage();
            renderUI();
        }

        function deleteConsole(id) {
            if (confirm('آیا از حذف این کنسول مطمئن هستید؟')) {
                if (timers[id]) clearInterval(timers[id]);
                consoles = consoles.filter(i => i.id !== id);
                saveToStorage();
                renderUI();
            }
        }

        function updateRate() {
            let newRate = parseInt(document.getElementById('inputRate').value);
            if (isNaN(newRate) || newRate <= 0) return alert('لطفاً یک نرخ معتبر وارد کنید.');
            hourlyRate = newRate;
            saveToStorage();
            renderUI();
            alert('نرخ جدید با موفقیت ذخیره شد.');
        }

        function switchTab(tab) {
            ['dashboard', 'settings', 'about'].forEach(t => {
                document.getElementById(`tab-${t}`).classList.add('hidden');
                document.getElementById(`nav-${t}`).className = "flex items-center gap-4 px-3 py-3 rounded-xl text-slate-400 hover:bg-slate-800 hover:text-white transition whitespace-nowrap";
            });
            document.getElementById(`tab-${tab}`).classList.remove('hidden');
            document.getElementById(`nav-${tab}`).className = "flex items-center gap-4 px-3 py-3 rounded-xl bg-cyan-600 text-white font-medium transition whitespace-nowrap";
        }
    </script>
</body>
</html>
